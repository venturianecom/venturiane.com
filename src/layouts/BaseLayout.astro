---
import { translations, type Language } from "../i18n/config";

interface Props {
  language: Language;
  title: string;
  description: string;
  canonicalPath: string;
  locale: string;
  alternateLocale: string;
  alternatePaths?: Partial<Record<Language, string>>;
  type?: "website" | "article";
  robots?: string;
  article?: {
    title: string;
    author: {
      name: string;
      url: string;
    };
    publishedTime: Date;
    readingMinutes: number;
    modifiedTime?: Date;
    tags: string[];
  };
}

const {
  language,
  title,
  description,
  canonicalPath,
  locale,
  alternateLocale,
  alternatePaths = { nl: "/nl/", en: "/en/" },
  type = "website",
  robots = "index, follow",
  article,
} = Astro.props;
const site = Astro.site ?? new URL("https://venturiane.com");
const canonicalUrl = new URL(canonicalPath, site).href;
const socialImageUrl = new URL("/social-preview.png", site).href;
const skipLabel = translations[language].skipLabel;
const organizationNode = {
  "@type": "Organization",
  "@id": new URL("/#organization", site).href,
  name: "Venturian Ecom",
  url: site.href,
  email: "hello@venturiane.com",
  knowsAbout: ["Technology consulting", "E-commerce"],
};
const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@graph": [
        organizationNode,
        {
          "@type": "BlogPosting",
          "@id": `${canonicalUrl}#article`,
          headline: article.title,
          description,
          url: canonicalUrl,
          mainEntityOfPage: canonicalUrl,
          datePublished: article.publishedTime.toISOString(),
          dateModified: (
            article.modifiedTime ?? article.publishedTime
          ).toISOString(),
          inLanguage: language,
          keywords: article.tags,
          author: {
            "@type": "Person",
            name: article.author.name,
            url: article.author.url,
          },
          timeRequired: `PT${article.readingMinutes}M`,
          publisher: { "@id": organizationNode["@id"] },
        },
      ],
    }
  : { "@context": "https://schema.org", ...organizationNode };
const xDefaultUrl = alternatePaths.en
  ? new URL(alternatePaths.en, site).href
  : site.href;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07111f" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {Object.entries(alternatePaths).map(([alternateLanguage, path]) => (
      <link
        rel="alternate"
        hreflang={alternateLanguage}
        href={new URL(path, site).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="venturian ecom" />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:site_name" content="Venturian Ecom" />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.publishedTime.toISOString()}
        />
        <meta
          property="article:modified_time"
          content={(
            article.modifiedTime ?? article.publishedTime
          ).toISOString()}
        />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="venturian ecom" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {skipLabel}
    </a>
    <slot />
  </body>
</html>
