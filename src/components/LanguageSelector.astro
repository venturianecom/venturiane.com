---
import {
  languageNames,
  languageRoutes,
  supportedLanguages,
  translations,
  type Language,
} from "../i18n/config";

interface Props {
  language: Language;
  routes?: Partial<Record<Language, string>>;
}

const { language, routes = languageRoutes } = Astro.props;
const copy = translations[language];
---

<details class="language-picker" data-language-picker>
  <summary
    class="language-trigger"
    aria-label={`${copy.languageLabel}: ${languageNames[language]}`}
  >
    <svg class="language-globe" aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
    </svg>
    <span>{languageNames[language]}</span>
    <svg class="language-chevron" aria-hidden="true" viewBox="0 0 16 16">
      <path d="m4 6 4 4 4-4"></path>
    </svg>
  </summary>
  <ul class="language-menu">
    {supportedLanguages.map((option) => (
      <li>
        <a
          class="language-option"
          href={routes[option] ?? languageRoutes[option]}
          hreflang={option}
          lang={option}
          data-language={option}
          aria-current={option === language ? "page" : undefined}
        >
          <span>{languageNames[option]}</span>
          {option === language && (
            <svg aria-hidden="true" viewBox="0 0 16 16">
              <path d="m3 8 3 3 7-7"></path>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  import { isLanguage, languageStorageKey } from "../i18n/config";

  const pickers = document.querySelectorAll<HTMLDetailsElement>(
    "[data-language-picker]",
  );

  document.querySelectorAll<HTMLElement>("[data-language]").forEach((link) => {
    const language = link.dataset.language;
    if (!language || !isLanguage(language)) {
      return;
    }

    link.addEventListener("click", () => {
      try {
        localStorage.setItem(languageStorageKey, language);
      } catch {
        // Navigation still works when browser storage is unavailable.
      }
    });
  });

  document.addEventListener("click", (event) => {
    pickers.forEach((picker) => {
      if (!picker.contains(event.target as Node)) {
        picker.open = false;
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      pickers.forEach((picker) => (picker.open = false));
    }
  });
</script>
