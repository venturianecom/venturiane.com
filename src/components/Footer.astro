---
import { translations, type Language } from "../i18n/config";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const copy = translations[language];
const currentYear = new Date().getFullYear();
---

<footer>
  <p>
    <a class="footer-company-link" href={`/${language}/company-details/`}>
      © {currentYear} Venturian Ecom.
      <span class="visually-hidden">{copy.footer.companyDetails}</span>
    </a>
  </p>
  <p>
    {copy.footer.made}{" "}
    <span class="heart" aria-hidden="true">
      ♥
    </span>
    <span class="visually-hidden">{copy.footer.heartLabel}</span>{" "}
    {copy.footer.by} Venturian Ecom.
  </p>
</footer>
