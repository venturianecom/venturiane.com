---
import { translations, type Language } from "../i18n/config";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  language: Language;
  alternatePaths: Partial<Record<Language, string>>;
}

const { language, alternatePaths } = Astro.props;
const copy = translations[language];
---

<header class="article-header">
  <a class="brand" href={`/${language}/`} aria-label={copy.articleBackLabel}>
    venturian ecom
  </a>
  <LanguageSelector language={language} routes={alternatePaths} />
</header>
